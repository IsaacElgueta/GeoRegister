<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:visibility="visible"
    tools:context=".Main_RegistrarIncidencia"
    tools:visibility="visible">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar2"
        android:layout_width="409dp"
        android:layout_height="85dp"
        android:background="?attr/colorPrimary"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintBottom_toTopOf="@+id/constraintLayout3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout3"
        android:layout_width="402dp"
        android:layout_height="641dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageButton"
        app:layout_constraintVertical_bias="0.5">

        <EditText
            android:id="@+id/etTitulo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="42dp"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="42dp"
            android:layout_marginBottom="26dp"
            android:ems="10"
            android:hint="@string/incidencia_titulo"
            android:inputType="text"
            android:maxEms="20"
            android:importantForAutofill="no"
            app:layout_constraintBottom_toTopOf="@+id/etDescripcion"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/etDescripcion"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="42dp"
            android:layout_marginEnd="42dp"
            android:layout_marginBottom="45dp"
            android:ems="10"
            android:hint="@string/incidencia_descripcion"
            android:inputType="text"
            android:maxEms="80"
            android:importantForAutofill="no"
            app:layout_constraintBottom_toTopOf="@+id/spinnerCategoria"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/etTitulo" />

        <Spinner
            android:id="@+id/spinnerCategoria"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="72dp"
            android:layout_marginEnd="72dp"
            android:layout_marginBottom="27dp"
            android:spinnerMode="dropdown"
            app:layout_constraintBottom_toTopOf="@+id/etFechaHora"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/etDescripcion" />

        <EditText
            android:id="@+id/etLongitud"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="42dp"
            android:layout_marginBottom="56dp"
            android:ems="10"
            android:hint="@string/incidencia_longitud"
            android:inputType="numberSigned|numberDecimal"
            android:importantForAutofill="no"
            app:layout_constraintBottom_toTopOf="@+id/btnObtenerUbicacion"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/etLatitud"
            app:layout_constraintTop_toBottomOf="@+id/etFechaHora" />

        <EditText
            android:id="@+id/etLatitud"
            android:layout_width="0dp"
            android:layout_height="47dp"
            android:layout_marginStart="45dp"
            android:layout_marginEnd="28dp"
            android:ems="10"
            android:hint="@string/incidencia_latitud"
            android:inputType="numberSigned|numberDecimal"
            android:importantForAutofill="no"
            app:layout_constraintBaseline_toBaselineOf="@+id/etLongitud"
            app:layout_constraintEnd_toStartOf="@+id/etLongitud"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/etFechaHora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="30dp"
            android:ems="10"
            android:hint="@string/incidencia_fecha_hora"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"
            android:importantForAutofill="no"
            app:layout_constraintBottom_toTopOf="@+id/etLongitud"
            app:layout_constraintEnd_toEndOf="@+id/spinnerCategoria"
            app:layout_constraintTop_toBottomOf="@+id/spinnerCategoria" />

        <Button
            android:id="@+id/btnObtenerUbicacion"
            android:layout_width="171dp"
            android:layout_height="0dp"
            android:layout_marginBottom="18dp"
            android:text="@string/obtener_ubicacion"
            app:layout_constraintBottom_toTopOf="@+id/btnGuardar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/etLongitud" />

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="171dp"
            android:layout_height="0dp"
            android:layout_marginBottom="49dp"
            android:text="@string/guardar_incidencia"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnObtenerUbicacion" />

        <TextView
            android:id="@+id/textView5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/incidencia_categoria"
            app:layout_constraintBottom_toTopOf="@+id/spinnerCategoria"
            app:layout_constraintStart_toStartOf="@+id/spinnerCategoria"
            app:layout_constraintTop_toTopOf="@+id/spinnerCategoria" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="91dp"
        android:text="@string/nueva_incidencia"
        android:textColor="@color/white"
        android:textSize="30sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageButton"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/imageButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="11dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#10FFFFFF"
        android:contentDescription="@string/volver"
        app:layout_constraintBottom_toTopOf="@+id/constraintLayout3"
        app:layout_constraintEnd_toStartOf="@+id/textView4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/actionModeCloseDrawable" />

</androidx.constraintlayout.widget.ConstraintLayout>